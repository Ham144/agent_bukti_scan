# Salin ke .env di folder yang sama dengan BuktiScan Agent.exe
# atau ke %APPDATA%\BuktiScan\.env

# URL backend production (tanpa slash di akhir)
BuktiScan_API_URL=http://192.168.169.12:

# URL server tempat latest.yml + installer di-host (untuk auto-update)
# Jika tidak diisi, auto-update akan menggunakan {BuktiScan_API_URL}/downloads
# BuktiScan_UPDATE_URL=http://192.168.169.12:4321/downloads

# Opsional — folder simpan klip
# BuktiScan_CLIPS_DIR=D:\BuktiScan\clips
